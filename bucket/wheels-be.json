{
    "##": "Bleeding-edge channel - tracks every merge to develop. Self-contained:",
    "##2": "OpenJDK 21 inlined as a 5th url/hash so `scoop install wheels-be` works",
    "##3": "from a fresh shell with no prerequisite buckets. Hashes for wheels-module",
    "##4": "and wheels-core are kept current by .github/workflows/autoupdate.yml. Hashes for wheels-docs are kept current by the same workflow.",
    "version": "4.2.0-snapshot.2954",
    "description": "Wheels CFML MVC framework - bleeding-edge channel (develop snapshots).",
    "homepage": "https://wheels.dev",
    "license": "Apache-2.0",
    "notes": [
        "Bleeding-edge channel: tracks every merge to develop on wheels-dev/wheels.",
        "Conflicts with the stable 'wheels' package - install only one channel at a time.",
        "Switch channels with: scoop uninstall wheels-be ; scoop install wheels",
        "First run will sync the module and framework into ~/.wheels.",
        "The prebuilt guides and API reference are installed offline and mirrored into an app's public\\wheels-docs."
    ],
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/wheels-dev/wheels-snapshots/releases/download/v4.2.0-snapshot.2954/wheels-module-4.2.0-snapshot.2954.zip",
                "https://github.com/wheels-dev/wheels-snapshots/releases/download/v4.2.0-snapshot.2954/wheels-core-4.2.0-snapshot.2954.zip",
                "https://github.com/wheels-dev/LuCLI/releases/download/v0.6.2.2/lucli-0.6.2.2.jar#/lucli.jar",
                "https://repo1.maven.org/maven2/org/xerial/sqlite-jdbc/3.49.1.0/sqlite-jdbc-3.49.1.0.jar",
                "https://download.java.net/java/GA/jdk21.0.2/f2283984656d49d69e91c558476027ac/13/GPL/openjdk-21.0.2_windows-x64_bin.zip",
                "https://github.com/wheels-dev/wheels-snapshots/releases/download/v4.2.0-snapshot.2954/wheels-docs-4.2.0-snapshot.2954.zip"
            ],
            "hash": [
                "sha512:87c8771d687377b3bf496730836ccb1daf897df63678cad68d3e8b92f3a85eb8b3fb2863f45c5b72ed34d5cc42b2001240f2fd001660ebb047bb9e58538cc975",
                "sha512:95f53fb837dce7ff01a177aaca677fe4d59e30b3e00bd2c7e3a3802c6fcf83d3297f92fba68cf5547a6c6f2630a08d4eaa96567461bcdff5c41f21aef1400847",
                "7d8b4089ec31e8d466d3b52f3743921d389d90c549b723f2126b8108848ef46a",
                "5c8609d2ca341deb8c6f71778974b5ba4995c7d32d7c7c89d9392a3e72c39291",
                "b6c17e747ae78cdd6de4d7532b3164b277daee97c007d3eaa2b39cca99882664",
                "sha512:05b332714199e5d71d27183e2c5d90620b43f6b4351cd3ea2beb44c9527b6c9061e3b114321db887b0dffaf69275d7616242d1904382b29665a2cce0b6a63639"
            ],
            "extract_dir": [
                "",
                "wheels",
                "",
                "",
                "jdk-21.0.2",
                ""
